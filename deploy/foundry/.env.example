# Variables para ejecutar el agente y la web FUERA de Azure (proceso local). Ver CONFIGURATION.md.
# Copie a .env (ignorado por git). Valores de ejemplo ficticios: sustitúyalos por los suyos.
#
# Precedencia: variable de la terminal > .env > valor por defecto del código.
#   - scripts/run-local.ps1 carga .env sin sobrescribir la terminal y fija, según -Responder y -Sql,
#     STARTER_RESPONDER, TEXT2SQL_EXECUTE, TEXT2SQL_SQL_BACKEND, FILES_MODE y WEB_AGENT_MODE.
#   - text2sql_core (python-dotenv) también lee .env, pero solo al construir la configuración SQL_*.
#   - «python agent/main.py» lanzado a mano NO lee MODEL_* de .env: use run-local.ps1 -Mode agent.
# Compruebe la configuración sin mostrar valores: ./scripts/run-local.ps1 -Check [-Responder model] [-Sql odbc]
# Para publicar en Foundry NO se usa este archivo: ver agent.env.example.

# === OBLIGATORIAS: vista autorizada (mismas variables que el agente original) ===
# Sin ellas, run-local.ps1 usa una vista ficticia con -Sql simulated/none y falla con -Sql odbc.
# NO se asume dbo: use el esquema asignado.
SQL_VIEW_SCHEMA=REEMPLAZAR_ESQUEMA
SQL_VIEW_NAME=vw_chatbot_mom

# === OPCIONALES: motor y límites ===
# No escriba comentarios al final de una línea KEY=valor: run-local.ps1 los tomaría como parte del valor.
# SQL_ENGINE: sqlserver (por defecto) | azuresql
SQL_ENGINE=sqlserver
# SQL_MAX_ROWS: 1-1000 (200) · SQL_DEFAULT_ROWS: 1-SQL_MAX_ROWS (50) · SQL_QUERY_TIMEOUT: 1-120 s (30)
SQL_MAX_ROWS=200
SQL_DEFAULT_ROWS=50
SQL_QUERY_TIMEOUT=30

# === CONDICIONALES: modelo real (solo con -Responder model; token Entra de «az login», sin claves) ===
# Requiere el rol Cognitive Services OpenAI User en el recurso del modelo.
# MODEL_ENDPOINT=https://<recurso>.openai.azure.com
# MODEL_DEPLOYMENT_NAME=<despliegue>
# Opcionales del modelo:
# MODEL_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default
# MODEL_TIMEOUT_SECONDS=45
# MODEL_MAX_OUTPUT_TOKENS=2000
# MODEL_TEMPERATURE vacía = no se envía (algunos modelos de razonamiento no la admiten)
# MODEL_TEMPERATURE=

# === CONDICIONALES: conexión SQL (solo con -Sql odbc o text2sql_core.py --metadatos/--ejecutar) ===
# Cuenta de SOLO LECTURA sobre la vista. Requiere Microsoft ODBC Driver 17 o 18 instalado localmente.
# Opción A (preferible, sin contraseña): cadena completa; tiene prioridad sobre la opción B.
# SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:<servidor>.database.windows.net,1433;Database=<bd>;Authentication=ActiveDirectoryInteractive;Encrypt=yes
SQL_CONNECTION_STRING=
# Opción B: las cuatro variables (SQL_SERVER es solo el hostname, sin tcp: ni puerto).
SQL_SERVER=
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=
# Opcional con la opción B (ODBC Driver 18 for SQL Server por defecto). Local puede ser 17 o 18 (el instalado
# en este equipo; run-local.ps1 -Check lo comprueba). El agente publicado usa el de agent.env (Driver 18).
SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# === OPCIONALES: ejecución (run-local.ps1 -Sql las fija; solo si arranca los procesos a mano) ===
# TEXT2SQL_EXECUTE: false (por defecto) | true ejecuta el SQL validado
# TEXT2SQL_SQL_BACKEND: odbc (por defecto) | simulated
# TEXT2SQL_EXECUTE=false
# TEXT2SQL_SQL_BACKEND=odbc

# === OPCIONALES: web local ===
WEB_TITLE=Text-to-SQL · pruebas
# Web contra el agente ya publicado, con su identidad de «az login» (etapa de publicación):
# WEB_AGENT_MODE=foundry
# WEB_AUTH=developer
# PROJECT_ENDPOINT=https://<prefix>-foundry.services.ai.azure.com/api/projects/<prefix>-project
# HOSTED_AGENT_NAME=<prefix>-agent
# EXPECTED_TENANT_ID=00000000-0000-0000-0000-000000000000
# ALLOWED_USER_OBJECT_IDS=00000000-0000-0000-0000-000000000000
# WEB_FILES_MODE=none

# === Solo la CLI original (python agent/text2sql_core.py "pregunta"); el agente NO las usa ===
AZURE_OPENAI_ENDPOINT=https://REEMPLAZAR.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=REEMPLAZAR_DESPLIEGUE
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_KEY=
