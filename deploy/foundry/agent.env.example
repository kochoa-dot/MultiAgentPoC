# Configuración del Hosted Agent publicado, para scripts/publish-agent.ps1.
# Copie a agent.env (ignorado por git) y edítelo. SIN SECRETOS: el script rechaza claves desconocidas,
# SQL_PASSWORD, contraseñas en la cadena de conexión y variables FOUNDRY_*/AGENT_*.
# El alojamiento (proyecto, nombre del agente, registro, Storage) sale de Bicep, no de aquí.
# Es independiente del .env local: local puede usar otro driver ODBC (p. ej. 17) y este fija el de la imagen.

# --- Vista autorizada (obligatorio)
SQL_ENGINE=sqlserver
SQL_VIEW_SCHEMA=REEMPLAZAR_ESQUEMA
SQL_VIEW_NAME=vw_chatbot_mom
SQL_MAX_ROWS=200
SQL_DEFAULT_ROWS=50
SQL_QUERY_TIMEOUT=30

# --- Ejecución. false = genera y valida SQL sin conectarse. true exige agentHosting.mode=container
# (la imagen docker/agent.Dockerfile es la que trae el driver ODBC).
TEXT2SQL_EXECUTE=false

# --- Driver de la imagen publicada. Debe ser exactamente este (el único instalado en el contenedor).
SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# --- Conexión SQL (solo si TEXT2SQL_EXECUTE=true). Opción A: autenticación SQL existente.
# La contraseña NO va aquí: ./scripts/set-sql-secret.ps1 la guarda en la conexión CustomKeys del proyecto
# indicada en SQL_PASSWORD_CONNECTION y Foundry la inyecta como SQL_PASSWORD al iniciar la sesión.
# SQL_SERVER es solo el hostname, sin protocolo ni puerto.
# SQL_SERVER=<servidor>.database.windows.net
# SQL_DATABASE=<base de datos>
# SQL_USER=<usuario SQL de solo lectura>
# SQL_PASSWORD_CONNECTION=sql-credentials
SQL_SERVER=
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD_CONNECTION=

# --- Conexión SQL, opción B: cadena ODBC completa SIN contraseña (excluye la opción A).
# Authentication=ActiveDirectoryMsi no es compatible con el servicio de tokens del Hosted Agent:
# ver TROUBLESHOOTING.md «Driver ODBC en el Hosted Agent».
SQL_CONNECTION_STRING=

# --- Modelo existente (decisión del piloto: model.deploy=false en los parámetros Bicep). Obligatorio entonces.
# MODEL_RESOURCE_ID no llega al contenedor: publish-agent.ps1 lo usa para asignar Cognitive Services OpenAI User
# a la identidad del agente en ese recurso (el operador necesita roleAssignments/write allí).
# MODEL_ENDPOINT=https://<recurso>.openai.azure.com
# MODEL_DEPLOYMENT_NAME=<despliegue>
# MODEL_RESOURCE_ID=/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<recurso>
MODEL_ENDPOINT=
MODEL_DEPLOYMENT_NAME=
MODEL_RESOURCE_ID=
