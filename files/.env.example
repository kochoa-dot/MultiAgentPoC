# Confirma el motor real antes de ejecutar. Esta versión usa SQL Server/Azure SQL.
SQL_ENGINE=sqlserver
# NO se asume dbo. Sustituir por el esquema asignado.
SQL_VIEW_SCHEMA=REEMPLAZAR_ESQUEMA
# Nombre deducido del CSV; confirmar el nombre real de la vista.
SQL_VIEW_NAME=vw_chatbot_mom
SQL_MAX_ROWS=200
SQL_DEFAULT_ROWS=50
SQL_QUERY_TIMEOUT=30

AZURE_OPENAI_ENDPOINT=https://REEMPLAZAR.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=REEMPLAZAR_DESPLIEGUE
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_KEY=

# Solo para --metadatos o --ejecutar, no se requieren para generar SQL.
SQL_SERVER=
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=
SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# Alternativa: cadena corporativa aprobada (por ejemplo, identidad administrada).
# Si existe, sustituye SQL_SERVER/SQL_DATABASE/SQL_USER/SQL_PASSWORD.
SQL_CONNECTION_STRING=
