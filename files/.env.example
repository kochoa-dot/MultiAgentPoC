# Renombra este archivo a .env y completa con tus valores reales.
# Nunca subas el .env real a un repositorio.

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://tu-recurso.openai.azure.com/
AZURE_OPENAI_KEY=tu_api_key_aqui
AZURE_OPENAI_DEPLOYMENT=tu_deployment
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Azure SQL Database ---
SQL_SERVER=tu-servidor.database.windows.net
SQL_DATABASE=tu_base_de_datos
SQL_USER=tu_usuario
SQL_PASSWORD=tu_contrasena
